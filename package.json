{
  "name": "rivar-booster-server",
  "version": "1.0.0",
  "description": "WebSocket infrastructure server for Rivar Booster APK fleet management",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
